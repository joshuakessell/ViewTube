# Signaling (how the two phones find each other and stay in sync).
# Both values are safe to ship in the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx

# Optional: JSON array of RTCIceServer objects. Add a TURN server here if the
# call will not connect on mobile data. Defaults to public STUN servers.
# VITE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
